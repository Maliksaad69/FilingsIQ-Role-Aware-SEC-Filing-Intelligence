# ============================================================
# FilingsIQ Environment Configuration
# ============================================================

# Qdrant Cloud (Vector Store)
QDRANT_URL=https://your-cluster-id.region.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key

COHERE_API_KEY=your_cohere_api_key
COHERE_RERANK_MODEL=rerank-v5.0-pro
COHERE_GENERATION_MODEL=command-a-03-2025

# Evaluation LLM Judge (OpenAI-compatible endpoint, e.g. Groq / Mistral)
GROQ_API_KEY=your_groq_api_key
